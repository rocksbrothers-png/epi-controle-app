# ── Flutter Web (SaaS) — deploy determinístico via Docker ─────────────────────
# Compila o app Flutter Web e serve os arquivos estáticos (com fallback de SPA).
# Alternativa robusta ao "static site" do Render (que não tem Flutter no build).
# Render: criar um Web Service (Docker) apontando para este arquivo. Sem publish
# directory; o serviço escuta em $PORT.

# Stage 1 — build do Flutter Web
FROM debian:bookworm-slim AS web-builder

ENV TAR_OPTIONS="--no-same-owner --no-same-permissions" \
    FLUTTER_HOME=/opt/flutter \
    PUB_CACHE=/root/.pub-cache
ENV PATH="$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$PUB_CACHE/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Flutter STABLE (o pubspec.lock exige flutter >=3.44; intl ^0.20.2).
RUN git clone --depth 1 --branch stable https://github.com/flutter/flutter.git $FLUTTER_HOME \
    && flutter config --no-analytics --enable-web \
    && dart pub global activate melos

WORKDIR /src
COPY flutter/ ./flutter/

WORKDIR /src/flutter
RUN melos bootstrap && melos run gen:l10n && melos run gen

# URL da API do SaaS (override via --build-arg se necessário).
ARG API_BASE_URL=https://epi-controle-app-livamobile-api.onrender.com
WORKDIR /src/flutter/apps/epi_admin
RUN flutter build web --release \
    --base-href / \
    --dart-define=API_BASE_URL=$API_BASE_URL

# Stage 2 — runtime estático (Python, sem deps externas)
FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 WEB_ROOT=/web
WORKDIR /web
COPY --from=web-builder /src/flutter/apps/epi_admin/build/web/ ./
COPY scripts/serve_web.py /serve_web.py
EXPOSE 8000
CMD ["python", "/serve_web.py"]
