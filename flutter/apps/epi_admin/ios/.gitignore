# ── #238: projeto Xcode é GERADO, não versionado ─────────────────────────────
# `flutter create . --platforms=ios` recria tudo abaixo a cada execução do CI
# (ver .github/workflows/ios_ci.yml, passo "Prepare iOS project"). Versionar
# qualquer um deles faz a cópia commitada substituir o resultado da geração — e
# ela para de refletir o pubspec/plugins sem nada acusar. Foi o que aconteceu
# entre o merge 27611d3 e a #238.
#
# O que PERMANECE versionado, por não ser gerável: Runner/Info.plist (fonte do
# bundle id), Runner/Runner.entitlements, Runner/PrivacyInfo.xcprivacy,
# ExportOptions.plist, Gemfile e fastlane/.
Runner.xcodeproj/
Runner.xcworkspace/
RunnerTests/
Runner/AppDelegate.swift
Runner/Assets.xcassets/
Runner/Base.lproj/
Runner/Runner-Bridging-Header.h
Flutter/AppFrameworkInfo.plist
Flutter/Debug.xcconfig
Flutter/Release.xcconfig

# CocoaPods: o Podfile é gerado por `flutter build ios --config-only` e depois
# ajustado por fastlane/pin_ios_deployment_target.rb. Um Podfile versionado
# sobreviveria à geração e mascararia mudanças de plugin, como acima.
Podfile
Podfile.lock
