# =============================================================================
# AMBIENTE: EPI-CONTROLE-APP  (PRODUTO SaaS — Liva Mobile)
# =============================================================================
# Este arquivo descreve as variáveis do ambiente **SaaS**. NÃO use credenciais
# do ambiente corporativo/legado (repo EPI-CONTROLE). Banco, deploy e Firebase
# são SEPARADOS. Ver docs/DEPLOY_SAAS.md.
# =============================================================================

# ========================
# Banco de dados PostgreSQL (Supabase SaaS)
# ========================
# Projeto Supabase SaaS: wlneevhqklboctghvdeo (us-east-1) — NUNCA o corporativo kkmskwmkhyssrxqbsrqv (sa-east-1).
# IMPORTANTE: copie a string EXATA do painel Supabase (Project Settings → Database).
# O projeto SaaS é us-east-1 — o host do pooler reflete essa região (NÃO use sa-east-1).
DATABASE_URL=postgresql://postgres.wlneevhqklboctghvdeo:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ========================
# Autenticação JWT
# ========================
JWT_SECRET=

# ========================
# Supabase (SaaS)
# ========================
SUPABASE_URL=https://wlneevhqklboctghvdeo.supabase.co
SUPABASE_ANON_KEY=

# ========================
# Ambiente
# ========================
APP_ENV=production
# Compatibilidade com plataformas que já usam ENVIRONMENT
ENVIRONMENT=production

# ========================
# Servidor
# ========================
PORT=8000

# ========================
# OCR (Tesseract)
# ========================
TESSERACT_CMD=/usr/bin/tesseract

# ========================
# Segurança HTTP
# ========================
# Origem do front-end SaaS (Flutter Web servido como static site separado).
# No SaaS o front e a API ficam em ORIGENS DIFERENTES → CORS é obrigatório.
CORS_ALLOW_ORIGIN=https://epi-controle-app-livamobile-web.onrender.com
# Chave opcional para liberar diagnóstico completo em /api/auth-diagnostics via X-Diagnostics-Key.
AUTH_DIAGNOSTICS_KEY=

# ========================
# Fronteira de confiança de proxy (R0.5)
# ========================
# Quantos proxies CONFIÁVEIS existem entre o cliente e esta aplicação.
# `get_client_ip` devolve `X-Forwarded-For[-N]`; fora da cadeia declarada vale o
# peer do socket. O padrão, quando a variável não existe, é 0 — ignorar o
# cabeçalho por completo, que é o único valor seguro sem configuração.
#
# 3 foi MEDIDO contra os dois serviços no Render em 2026-09-22, com três
# controles e três repetições cada. A evidência está em
# docs/R05_CADEIA_DE_PROXY.md. Mudança de borda exige nova medição: este número
# não se deduz, e errar para cima devolve endereço escrito pelo cliente.
RATE_LIMIT_TRUSTED_PROXY_HOPS=3

# Endpoint opcional para receber violações CSP em modo report-only
CSP_REPORT_URI=/api/csp-report

# ========================
# URLs públicas (SaaS — deploy SEPARADO: API e Web em serviços Render distintos)
# ========================
# API backend (Docker full-stack) — onde o app Flutter (mobile/web) consome a API.
API_BASE_URL=https://epi-controle-app-livamobile-api.onrender.com
# Front-end web (Flutter Web static site).
WEB_BASE_URL=https://epi-controle-app-livamobile-web.onrender.com
# Retorno após assinatura/pagamento (app web do SaaS).
WEB_APP_URL=https://epi-controle-app-livamobile-web.onrender.com

# ========================
# Mercado Pago (pagamentos / assinaturas)
# ========================
# SECRETO — usado apenas no backend. NUNCA exponha no frontend/Static Site.
MERCADO_PAGO_ACCESS_TOKEN=
# Seguro para uso no frontend (tokenização de cartão com o SDK do MP).
MERCADO_PAGO_PUBLIC_KEY=
# "sandbox" (homologação) ou "production".
MERCADO_PAGO_ENV=sandbox
# Opcional: segredo para validar a assinatura (x-signature) dos webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=

# ========================
# E-mail (SMTP) — usado no reset de senha e no envio das credenciais do dono
# no onboarding self-service (empresa ativada após o pagamento). Sem SMTP
# configurado a empresa ainda é ativada, mas o e-mail de credenciais falha
# (fica em log para reenvio manual via POST /api/onboarding/activate).
# ========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente exibido (fallback para SMTP_USER se vazio).
SMTP_FROM=
