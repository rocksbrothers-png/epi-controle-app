# ========================
# Banco de dados PostgreSQL
# ========================
DATABASE_URL=postgresql://postgres.seu_ref:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ========================
# Autenticação JWT
# ========================
JWT_SECRET=

# ========================
# Supabase
# ========================
SUPABASE_URL=https://kkmskwmkhyssrxqbsrqv.supabase.co
SUPABASE_ANON_KEY=

# ========================
# Ambiente
# ========================
APP_ENV=production
# Compatibilidade com plataformas que já usam ENVIRONMENT
ENVIRONMENT=production

# ========================
# Servidor
# ========================
PORT=8000

# ========================
# OCR (Tesseract)
# ========================
TESSERACT_CMD=/usr/bin/tesseract

# ========================
# Segurança HTTP
# ========================
# Em produção, informe explicitamente as origens permitidas (separadas por vírgula).
CORS_ALLOW_ORIGIN=https://seu-dominio.com
# Chave opcional para liberar diagnóstico completo em /api/auth-diagnostics via X-Diagnostics-Key.
AUTH_DIAGNOSTICS_KEY=

# Endpoint opcional para receber violações CSP em modo report-only
CSP_REPORT_URI=/api/csp-report

# ========================
# Mercado Pago (pagamentos / assinaturas)
# ========================
# SECRETO — usado apenas no backend. NUNCA exponha no frontend/Static Site.
MERCADO_PAGO_ACCESS_TOKEN=
# Seguro para uso no frontend (tokenização de cartão com o SDK do MP).
MERCADO_PAGO_PUBLIC_KEY=
# "sandbox" (homologação) ou "production".
MERCADO_PAGO_ENV=sandbox
# Opcional: segredo para validar a assinatura (x-signature) dos webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública do website (usada em back_urls / redirecionamentos).
WEB_BASE_URL=https://seu-dominio.com
# URL pública do app (retorno após assinatura/pagamento).
WEB_APP_URL=https://app.seu-dominio.com
