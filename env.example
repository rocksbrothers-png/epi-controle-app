# =============================================================================
# AMBIENTE: EPI-CONTROLE-APP  (PRODUTO SaaS — Liva Mobile)
# =============================================================================
# Este arquivo descreve as variáveis do ambiente **SaaS**. NÃO use credenciais
# do ambiente corporativo/legado (repo EPI-CONTROLE). Banco, deploy e Firebase
# são SEPARADOS. Ver docs/DEPLOY_SAAS.md.
# =============================================================================

# ========================
# Banco de dados PostgreSQL (Supabase SaaS)
# ========================
# Projeto Supabase SaaS: wlneevhqklboctghvdeo  (NUNCA o corporativo kkmskwmkhyssrxqbsrqv)
DATABASE_URL=postgresql://postgres.wlneevhqklboctghvdeo:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ========================
# Autenticação JWT
# ========================
JWT_SECRET=

# ========================
# Supabase (SaaS)
# ========================
SUPABASE_URL=https://wlneevhqklboctghvdeo.supabase.co
SUPABASE_ANON_KEY=

# ========================
# Ambiente
# ========================
APP_ENV=production
# Compatibilidade com plataformas que já usam ENVIRONMENT
ENVIRONMENT=production

# ========================
# Servidor
# ========================
PORT=8000

# ========================
# OCR (Tesseract)
# ========================
TESSERACT_CMD=/usr/bin/tesseract

# ========================
# Segurança HTTP
# ========================
# Origem do front-end SaaS (Flutter Web servido como static site separado).
# No SaaS o front e a API ficam em ORIGENS DIFERENTES → CORS é obrigatório.
CORS_ALLOW_ORIGIN=https://epi-controle-app-livamobile-web.onrender.com
# Chave opcional para liberar diagnóstico completo em /api/auth-diagnostics via X-Diagnostics-Key.
AUTH_DIAGNOSTICS_KEY=

# Endpoint opcional para receber violações CSP em modo report-only
CSP_REPORT_URI=/api/csp-report

# ========================
# URLs públicas (SaaS — deploy SEPARADO: API e Web em serviços Render distintos)
# ========================
# API backend (Docker full-stack) — onde o app Flutter (mobile/web) consome a API.
API_BASE_URL=https://epi-controle-app-livamobile-api.onrender.com
# Front-end web (Flutter Web static site).
WEB_BASE_URL=https://epi-controle-app-livamobile-web.onrender.com
# Retorno após assinatura/pagamento (app web do SaaS).
WEB_APP_URL=https://epi-controle-app-livamobile-web.onrender.com

# ========================
# Mercado Pago (pagamentos / assinaturas)
# ========================
# SECRETO — usado apenas no backend. NUNCA exponha no frontend/Static Site.
MERCADO_PAGO_ACCESS_TOKEN=
# Seguro para uso no frontend (tokenização de cartão com o SDK do MP).
MERCADO_PAGO_PUBLIC_KEY=
# "sandbox" (homologação) ou "production".
MERCADO_PAGO_ENV=sandbox
# Opcional: segredo para validar a assinatura (x-signature) dos webhooks.
MERCADO_PAGO_WEBHOOK_SECRET=
